FLASK_APP=run.py
FLASK_ENV=development
# 운영 전에 반드시 긴 임의 문자열로 바꾸세요 (예: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string
# instance/ 폴더 기준
DATABASE_URL=sqlite:///ledger.db
# QR에 들어갈 주소. 휴대폰 시험 시 PC의 사내 IP로 변경 (예: http://192.168.0.10:5000)
APP_BASE_URL=http://127.0.0.1:5000
# flask seed 때 만드는 admin 계정의 초기 비밀번호 (첫 로그인 때 변경)
ADMIN_INIT_PASSWORD=ChangeMe!2026
# 로그인 유지 시간(분)
SESSION_LIFETIME_MIN=480
# "로그인 유지" 선택 시 유지 일수
REMEMBER_DAYS=14
# HTTPS 로 운영할 때 1
SESSION_COOKIE_SECURE=0

# 메일 (로컬 시험은 console: 실제 발송하지 않고 서버 콘솔에 출력)
# console | smtp
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
MAIL_FROM=safety-ledger@example.com

# 1이면 앱 안에서 매일 자동 알림(설정의 발송 시각)과 DB 백업(02:30) 실행
SCHEDULER_ENABLED=0
UPLOAD_MAX_MB=10
